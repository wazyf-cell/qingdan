<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 云同步是核心功能，release 包必须能联网。
         Flutter 模板刻意只在 src/debug 与 src/profile 的覆盖清单里声明 INTERNET，
         主清单默认没有 —— 这意味着只跑 debug 构建的开发期永远发现不了问题，
         而 release 包会在真机上静默地每次同步都失败（SocketException）。
         2026-10-09 S7 Android 真机验收时发现，故显式声明在主清单里。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 通知（M6-C2）。插件自己的清单已经带了这一条，仍然在这里显式写一遍：
         依赖的清单哪天变了，我们的功能不该跟着静默失效。
         **刻意不声明 SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM** —— 排程用非精确闹钟
         （`AndroidScheduleMode.inexactAllowWhileIdle`），精确闹钟在 Android 12+
         要用户单独授权且政策收紧，而分钟级的提醒晚几十秒完全可以接受。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 应用内更新（1.0.4）：下载发布页的 APK 后调起系统安装器。
         这不是「静默安装」——系统仍会弹一次确认；只有 root / 设备所有者才跳得过。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="qingdan"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：教务系统普遍是 http（南昌航空强智入口
             `qzjwxt.nchu.edu.cn:800/jsxsd/`、校内网段 `172.16.x.x:800/` 都是明文），
             Android 自 API 28 起默认拒绝，WebView 直接报
             `ERR_CLEARTEXT_NOT_PERMITTED`（2026-10-18 真机抓到）。不能按域名放行，
             因为要抓哪个教务地址是用户当场在地址栏里输入的，事先无从枚举。
             代价：本应用允许明文流量。学习通侧全部接口与凭据都只走 https，
             云同步的坚果云也是 https，没有凭据经明文发送的路径。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 定时通知的三个 receiver（M6-C2）。**必须由应用自己声明**：
             `flutter_local_notifications 22.3.1` 自己的清单里只有两条 uses-permission，
             一个 receiver 都没声明（插件 README 明确要求宿主应用补上），
             manifest merger 也就不会替我们合。少了声明，AlarmManager 发出的
             广播没有接收方 —— 排程全部静默失效，界面上却一切「正常」，
             是比报错更糟的形状。
             核查方式（2026-10-18 实跑）：跑一次 debug 构建，再 grep
             `build/app/intermediates/merged_manifests/debug` 下合并出来的清单，
             当时里面只有 inappwebview 与 profileinstaller 两个 receiver，没有插件的。
             （注：XML 注释里不能写连续两个减号，所以构建命令不照抄在这里。） -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <!-- 重启 / 覆盖安装后把已排程的提醒重新装回 AlarmManager。 -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />
        <!-- 把缓存目录里的 APK 以 content:// 交给系统安装器：Android 7+ 直接
             传 file:// 会抛 FileUriExposedException。authority 必须与
             SystemIntents.kt 里拼的 "<包名>.fileprovider" 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
